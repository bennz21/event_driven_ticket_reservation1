PROJECT_NAME="SeatStream Event & Ticket Booking"
API_V1_STR="/api/v1"

# MySQL Database Settings
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=main_reservation

# JWT & Admin Settings (Admin credentials live ONLY in .env)
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
ADMIN_EMAIL=admin@seatstream.com
ADMIN_PASSWORD=change-admin-password
MAX_TICKETS_PER_BOOKING=5

FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
