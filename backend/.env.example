PROJECT_NAME="Event-Driven Ticket & Seat Reservation"
API_V1_STR="/api/v1"

# MySQL Database Settings (matches MySQL Workbench connection)
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ticket_reservation

# Alternatively, set full DATABASE_URL directly:
# DATABASE_URL=mysql+aiomysql://root:your_mysql_password@localhost:3306/ticket_reservation

REDIS_URL=redis://localhost:6379/0
USE_REDIS_EVENT_BUS=false
USE_REDIS_SEAT_LOCKING=true
USE_REDIS_CACHE=true
SEAT_CACHE_TTL_SECONDS=30
EVENT_CACHE_TTL_SECONDS=60
SEAT_HOLD_DURATION_SECONDS=300

# Authentication & OAuth Settings
JWT_SECRET_KEY=change-this-to-a-long-random-secret
FRONTEND_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
OAUTH_ALLOW_DEMO_LOGIN=false
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]
